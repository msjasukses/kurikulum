APP_NAME="SIM Kurikulum Sekolah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://kurikulum.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Konfigurasi default untuk Laragon (MySQL via database "kurikulum")
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kurikulum
DB_USERNAME=root
DB_PASSWORD=

# Koneksi kedua: database "datacenter" (sumber data Jurusan & Kelas/Rombel, read-only)
DATACENTER_DB_CONNECTION=mysql
DATACENTER_DB_HOST=127.0.0.1
DATACENTER_DB_PORT=3306
DATACENTER_DB_DATABASE=datacenter
DATACENTER_DB_USERNAME=root
DATACENTER_DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
